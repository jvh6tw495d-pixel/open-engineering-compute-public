{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evolutionary.hyperneat input",
  "type": "object",
  "properties": {
    "fitness": {
      "type": "string",
      "enum": ["xor", "tabular_regression", "tabular_classification"]
    },
    "x": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": { "type": "number" }
      }
    },
    "y": {
      "type": "array",
      "maxItems": 2000,
      "items": { "type": "number" }
    },
    "generations": { "type": "integer", "minimum": 1, "maximum": 500, "default": 30 },
    "population": { "type": "integer", "minimum": 4, "maximum": 500, "default": 50 },
    "seed": { "type": "integer", "default": 42 },
    "substrate": { "type": "string", "enum": ["layered_1d"], "default": "layered_1d" },
    "hidden_layers": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1 },
    "hidden_width": { "type": "integer", "minimum": 1, "maximum": 16, "default": 3 },
    "weight_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
    "feed_forward": { "type": "boolean", "default": true }
  },
  "required": ["fitness"],
  "additionalProperties": false
}
