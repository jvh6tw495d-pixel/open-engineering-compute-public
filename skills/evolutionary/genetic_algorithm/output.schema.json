{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evolutionary.optimize_single output",
  "type": "object",
  "properties": {
    "backend": { "type": "string" },
    "algorithm": { "type": "string" },
    "seed": { "type": "integer" },
    "best_objective": { "type": "number" },
    "best_x": { "type": "object" },
    "n_evaluations": { "type": "integer" },
    "n_generations": { "type": "integer" },
    "history_best": {
      "type": "array",
      "items": { "type": "number" }
    },
    "problem_fingerprint": { "type": "string" }
  },
  "required": ["backend", "algorithm", "best_objective", "best_x", "seed"],
  "additionalProperties": true
}
