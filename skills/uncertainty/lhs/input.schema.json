{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "n_samples": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "bounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "n_samples",
    "bounds"
  ],
  "additionalProperties": false
}
