{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "coeffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "intercept": {
      "type": "number"
    },
    "n_trajectories": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "n_levels": {
      "type": "integer",
      "minimum": 4,
      "multipleOf": 2,
      "description": "Classic Morris even grid size p >= 4"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "bounds",
    "coeffs"
  ],
  "additionalProperties": false
}
