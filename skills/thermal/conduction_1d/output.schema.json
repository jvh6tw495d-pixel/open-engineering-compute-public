{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thermal.conduction_1d output",
  "type": "object",
  "properties": {
    "heat_rate": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "W" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "description": "Q = k * A * (T_hot - T_cold) / L."
    },
    "balance": {
      "type": "object",
      "description": "ConservationCheck (not a QuantityValue) — residual of heat_in - heat_out.",
      "properties": {
        "residual": { "type": "number" },
        "balanced": { "type": "boolean" },
        "atol": { "type": "number", "minimum": 0 },
        "rtol": { "type": "number", "minimum": 0 },
        "scale": { "type": "number", "minimum": 0 },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Physical unit of the residual (W). Not a QuantityValue DTO."
        }
      },
      "required": ["residual", "balanced", "atol", "rtol", "scale", "unit"],
      "additionalProperties": false
    }
  },
  "required": ["heat_rate", "balance"],
  "additionalProperties": false
}
