{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mathematics.solve_root output",
  "type": "object",
  "properties": {
    "root": { "type": "number" },
    "method": { "type": "string", "enum": ["brentq", "bisect", "secant", "newton"] },
    "iterations": { "type": "integer", "minimum": 0 },
    "residual": { "type": "number", "minimum": 0 }
  },
  "required": ["root", "method", "iterations", "residual"],
  "additionalProperties": false
}
