{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "optimization.milp output",
  "type": "object",
  "properties": {
    "solver_status": { "type": "string" },
    "objective_value": { "type": ["number", "null"] },
    "primal": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "mip_gap": { "type": ["number", "null"] },
    "mip_node_count": { "type": ["integer", "null"] },
    "feasibility_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "backend": { "type": "string", "const": "highs" }
  },
  "required": [
    "solver_status",
    "objective_value",
    "primal",
    "mip_gap",
    "mip_node_count",
    "feasibility_issues",
    "backend"
  ],
  "additionalProperties": false
}
