{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "electrical.current_from_power output",
  "type": "object",
  "properties": {
    "current": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "A" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "description": "Single-phase: the system current. Three-phase: line current."
    },
    "electrical_power": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "W" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "description": "power / efficiency -- the actual power drawn from the supply, used in the current calculation"
    },
    "phase_count": { "type": "integer", "enum": [1, 3] },
    "power_type": { "type": "string", "enum": ["active", "apparent"] }
  },
  "required": ["current", "electrical_power", "phase_count", "power_type"],
  "additionalProperties": false
}
