{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "electrical.per_unit_conversion input",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["to_per_unit", "from_per_unit", "change_base"],
      "description": "to_per_unit: actual -> pu; from_per_unit: pu -> actual; change_base: pu on old base -> pu on new base."
    },
    "quantity_kind": {
      "type": "string",
      "enum": ["impedance", "voltage", "current", "power"],
      "description": "Which classical base relationship applies. Required for to_per_unit and from_per_unit; ignored for change_base (always impedance-style base change)."
    },
    "phase_count": {
      "type": "integer",
      "enum": [1, 3],
      "description": "Affects I_base and Z_base formulas (three-phase uses line-to-line voltage convention)."
    },
    "voltage_base": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "V",
      "description": "Voltage base. Three-phase: line-to-line."
    },
    "power_base": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "W",
      "description": "System power base (VA/kVA/MVA accepted)."
    },
    "value": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "description": "Actual quantity for to_per_unit. Unit must match quantity_kind (ohm/V/A/W). Not used for from_per_unit/change_base."
    },
    "value_pu": {
      "type": "number",
      "description": "Per-unit magnitude for from_per_unit or change_base (old base)."
    },
    "new_voltage_base": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "V",
      "description": "Required for change_base."
    },
    "new_power_base": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "W",
      "description": "Required for change_base."
    }
  },
  "required": ["operation", "phase_count", "voltage_base", "power_base"],
  "additionalProperties": false
}
