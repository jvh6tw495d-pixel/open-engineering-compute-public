{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "electrical.power_factor_correction output",
  "type": "object",
  "properties": {
    "existing_reactive_power": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "var" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false
    },
    "desired_reactive_power": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "var" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false
    },
    "capacitor_reactive_power": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "var" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "description": "Q_existing - Q_desired: reactive power the capacitor bank must supply."
    },
    "capacitance_per_unit": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "uF" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "description": "Capacitance of each capacitor unit in the bank (single unit for single_phase; per-phase for delta/star)."
    },
    "connection": { "type": "string", "enum": ["single_phase", "delta", "star"] },
    "phase_count": { "type": "integer", "enum": [1, 3] }
  },
  "required": [
    "existing_reactive_power",
    "desired_reactive_power",
    "capacitor_reactive_power",
    "capacitance_per_unit",
    "connection",
    "phase_count"
  ],
  "additionalProperties": false
}
