{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "neural.training.neuroevolution input",
  "type": "object",
  "properties": {
    "x": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "y": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number"
      }
    },
    "seed": {
      "type": "integer",
      "default": 42
    },
    "device": {
      "type": "string",
      "enum": [
        "cpu",
        "cuda",
        "auto"
      ],
      "default": "cpu"
    },
    "max_evaluations": {
      "type": "integer",
      "default": 40
    },
    "hidden": {
      "type": "integer",
      "default": 8
    },
    "max_params": {
      "type": "integer",
      "default": 500
    }
  },
  "required": [
    "x",
    "y"
  ],
  "additionalProperties": false
}
