{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "neural.evaluate input",
  "type": "object",
  "properties": {
    "x": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      }
    },
    "y": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "checkpoint": { "type": "object" },
    "normalize": { "type": ["object", "null"] },
    "task": {
      "type": "string",
      "enum": ["regression", "binary_classification", "multiclass_classification"],
      "default": "regression"
    },
    "device": { "type": "string", "enum": ["cpu", "cuda", "auto"], "default": "cpu" }
  },
  "required": ["x", "y", "checkpoint"],
  "additionalProperties": false
}
