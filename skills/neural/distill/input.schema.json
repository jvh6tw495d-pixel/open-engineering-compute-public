{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "neural.distill input",
  "type": "object",
  "properties": {
    "x": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}},
    "y": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "teacher_checkpoint": {"type": "object"},
    "teacher_normalize": {"type": ["object", "null"]},
    "student_hidden_dims": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "default": [8]},
    "activation": {"type": "string", "enum": ["relu", "gelu", "tanh", "sigmoid", "identity"], "default": "relu"},
    "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0},
    "temperature": {"type": "number", "const": 1.0, "default": 1.0},
    "loss_mix": {"type": "string", "enum": ["soft_only", "soft_and_target"], "default": "soft_and_target"},
    "soft_weight": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
    "epochs": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 80},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 16},
    "max_epochs": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
    "max_batch_size": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 128},
    "lr": {"type": "number", "exclusiveMinimum": 0, "default": 0.01},
    "val_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0},
    "seed": {"type": "integer", "default": 42},
    "normalize_x": {"type": "boolean", "default": true},
    "checkpoint_storage": {"type": "string", "enum": ["json_inline", "file"], "default": "json_inline"}
  },
  "required": ["x", "y", "teacher_checkpoint"],
  "additionalProperties": false
}
