{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "energy.min_storage_capacity input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "load",
    "pv",
    "eta_charge",
    "eta_discharge",
    "soc_min",
    "soc_max",
    "initial_soc",
    "horizon_hours"
  ],
  "properties": {
    "load": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "x-oec-unit": "Wh",
      "description": "Load energy per period (same unit as capacity)."
    },
    "pv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "x-oec-unit": "Wh"
    },
    "eta_charge": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "x-oec-dimensionless": true
    },
    "eta_discharge": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "x-oec-dimensionless": true
    },
    "soc_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-oec-dimensionless": true
    },
    "soc_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-oec-dimensionless": true
    },
    "initial_soc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-oec-dimensionless": true
    },
    "horizon_hours": {
      "type": "object",
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "h",
      "description": "Total horizon length (documentation / period dt = horizon/n)."
    },
    "curtailment_allowed": {
      "type": "boolean",
      "description": "If true, surplus PV may be curtailed (non-negative curtail variables)."
    }
  }
}
