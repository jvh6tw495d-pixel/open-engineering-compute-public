        "type": "object",
        "properties": {
          "value": { "type": "number" },
          "unit": { "type": "string" }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "x-oec-unit": "W",
      "description": "Provided grid trajectory; positive import makes grid-zero infeasible."
    },
    "dt_hours": {
      "type": "object",
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "h"
    },
    "atol": {
      "type": "number",
      "exclusiveMinimum": 0
