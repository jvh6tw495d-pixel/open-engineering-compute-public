{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "energy.grid_zero_feasibility input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "load",
    "pv",
    "storage_charge",
    "storage_discharge",
    "grid_import",
    "dt_hours"
  ],
  "properties": {
    "load": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "x-oec-unit": "W"
    },
    "pv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "x-oec-unit": "W"
    },
    "storage_charge": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "x-oec-unit": "W"
    },
    "storage_discharge": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "x-oec-unit": "W"
    },
    "grid_import": {
      "type": "array",
      "minItems": 1,
