{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "energy.service_metrics output",
  "type": "object",
  "additionalProperties": false,
  "required": ["energy_delivered", "autonomy_hours"],
  "properties": {
    "energy_delivered": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "const": "Wh" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "Wh"
    },
    "autonomy_hours": {
      "type": "object",
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "const": "h" }
      },
      "required": ["value", "unit"],
      "additionalProperties": false,
      "x-oec-unit": "h"
    }
  }
}
