{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linear.least_squares output",
  "type": "object",
  "properties": {
    "solution": {
      "type": "array",
      "items": { "type": "number" }
    },
    "residuals": {
      "type": "array",
      "items": { "type": "number" }
    },
    "rank": { "type": "integer", "minimum": 0 },
    "singular_values": {
      "type": "array",
      "items": { "type": "number" }
    },
    "residual_sum_of_squares": { "type": ["null", "number"] },
    "backend": { "type": "string" },
    "converged": { "type": ["null", "boolean"] }
  },
  "required": ["solution", "residuals", "rank", "singular_values", "residual_sum_of_squares", "backend", "converged"],
  "additionalProperties": false
}
