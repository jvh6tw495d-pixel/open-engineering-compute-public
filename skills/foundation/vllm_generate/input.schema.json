{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundation.vllm_generate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_url", "model_id", "prompt"],
  "properties": {
    "base_url": {
      "type": "string",
      "minLength": 1,
      "description": "http(s) URL of a running OpenAI-compatible vLLM server"
    },
    "model_id": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "max_new_tokens": { "type": "integer", "minimum": 1, "maximum": 512, "default": 32 },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0 },
    "seed": { "type": "integer" }
  }
}
