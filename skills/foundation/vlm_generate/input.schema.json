{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundation.vlm_generate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "image", "model_id"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image_base64": {
          "type": "string",
          "minLength": 1,
          "description": "Base64-encoded raster bytes (PNG/JPEG/WEBP). No URL download."
        },
        "image_path": {
          "type": "string",
          "minLength": 1,
          "description": "Local file path label. Must end in .png/.jpg/.jpeg/.webp."
        }
      },
      "oneOf": [
        { "required": ["image_base64"], "not": { "required": ["image_path"] } },
        { "required": ["image_path"], "not": { "required": ["image_base64"] } }
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "description": "HF hub id (requires revision) or an existing local model directory (local-only mode)."
    },
    "revision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Immutable 40-hex Hugging Face commit SHA. Required for remote hub model ids; optional for local paths."
    },
    "max_new_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512,
      "default": 32
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0
    },
    "seed": { "type": "integer", "default": 0 }
  }
}
