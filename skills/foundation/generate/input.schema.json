{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundation.generate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1 },
    "model_id": {
      "type": "string",
      "default": "sshleifer/tiny-gpt2"
    },
    "revision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Immutable 40-hex commit SHA required for remote model_id values; optional for existing local paths."
    },
    "max_new_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512,
      "default": 16
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0
    },
    "seed": { "type": "integer", "default": 0 },
    "adapter_path": {
      "type": "string",
      "minLength": 1,
      "description": "Optional trained adapter/checkpoint directory (from foundation.peft_train) to reload onto model_id before generating. Missing/unloadable path fails closed."
    },
    "adapter_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "Required when adapter_path is set. Pin of the adapter directory."
    }
  }
}
