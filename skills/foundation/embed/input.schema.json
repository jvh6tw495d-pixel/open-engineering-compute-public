{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foundation.embed input",
  "type": "object",
  "additionalProperties": false,
  "required": ["texts"],
  "properties": {
    "texts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "backend": {
      "type": "string",
      "enum": ["builtin_hash", "transformers"],
      "default": "builtin_hash"
    },
    "dim": { "type": "integer", "minimum": 8, "maximum": 1024, "default": 32 },
    "model_id": {
      "type": "string",
      "description": "HF model id when backend=transformers"
    },
    "revision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Immutable 40-hex commit SHA required when backend=transformers and model_id is remote."
    },
    "normalize": { "type": "boolean", "default": true },
    "seed": { "type": "integer", "default": 0 }
  }
}
