{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "statistics.intervals input",
  "type": "object",
  "properties": {
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "confidence_level": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "population_standard_deviation": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "description": "Known population σ for a Z-interval. Omit for Student-t."
    }
  },
  "required": ["samples"],
  "additionalProperties": false
}
