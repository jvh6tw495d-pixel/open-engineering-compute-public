{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "statistics.bootstrap input",
  "type": "object",
  "properties": {
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "statistic": {
      "type": "string",
      "enum": ["mean", "median", "variance"]
    },
    "confidence_level": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "n_resamples": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "seed": {
      "type": ["null", "integer"]
    }
  },
  "required": ["samples"],
  "additionalProperties": false
}